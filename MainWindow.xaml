<Window x:Class="ChatBotApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatBotApplication"
        Title="Cybersecurity Chatbot" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <!-- ✅ Window Resources -->
    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Black"
                                BorderThickness="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="10" Color="Black" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Gradient Backgrounds -->
        <LinearGradientBrush x:Key="TaskGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A8E6CF" Offset="0"/>
            <GradientStop Color="#D3FFF3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="QuizGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B2FEFA" Offset="0"/>
            <GradientStop Color="#0ED2F7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ChatGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C2FFD8" Offset="0"/>
            <GradientStop Color="#465EFB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LogGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0FF00" Offset="0"/>
            <GradientStop Color="#58CFFB" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <!-- Main Layout -->
    <Border CornerRadius="15" Margin="10" Background="#1E1E1E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Color="Black" Opacity="0.5"/>
        </Border.Effect>

        <Grid>

            <!-- ✅ Background MP4 Video -->
            <MediaElement x:Name="BackgroundVideo"
                          Source="images/abstract.mp4"
                          LoadedBehavior="Play"
                          UnloadedBehavior="Stop"
                          Stretch="UniformToFill"
                          IsMuted="True"
                          MediaEnded="BackgroundVideo_MediaEnded"
                          Panel.ZIndex="0"/>

            <!-- ✅ Dark overlay for contrast -->
            <Rectangle Fill="#40000000" Panel.ZIndex="1"/>

            <!-- ✅ Main Content -->
            <Grid Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ✅ Navigation Bar with Border -->
                <Border Height="80" Margin="0" BorderThickness="0,0,0,2" BorderBrush="#800080" CornerRadius="0,0,15,15">
                    <DockPanel LastChildFill="False">
                        <DockPanel.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#ff032b" Offset="0"/>
                                <GradientStop Color="#ffda03" Offset="1"/>
                            </LinearGradientBrush>
                        </DockPanel.Background>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" DockPanel.Dock="Top">
                            <TextBlock Text="Secure Chat Application"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#f9f9f9" Offset="0"/>
                                        <GradientStop Color="#f9f9f9" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,20,0">
                            <Button Content="─" Width="40" Background="Transparent" Click="MinimizeButton_Click"/>
                            <Button Content="✕" Width="40" Background="Transparent" Click="CloseButton_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ✅ Navigation Buttons -->
                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                    <UniformGrid Columns="2" Rows="2">
                        <Button Style="{StaticResource ModernButtonStyle}" Content="Task Log"
                                Background="Purple" Tag="TaskView" Click="NavButton_Click"/>
                        <Button Style="{StaticResource ModernButtonStyle}" Content="Quiz-Game"
                                Background="Purple" Tag="QuizView" Click="NavButton_Click"/>
                        <Button Style="{StaticResource ModernButtonStyle}" Content="Chat-Bot"
                                Background="Purple" Tag="ChatView" Click="NavButton_Click"/>
                        <Button Style="{StaticResource ModernButtonStyle}" Content="Activity Log"
                                Background="Purple" Tag="ActivityLogView" Click="NavButton_Click"/>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>