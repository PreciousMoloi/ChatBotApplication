<UserControl x:Class="ChatBotApplication.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <Grid>
        <!-- 🖼️ Background Image -->
        <Image Source="/images/flat-mountains (4).png"  
            Stretch="UniformToFill"
               Panel.ZIndex="0"/>

        <!-- 🧊 Optional Overlay for readability -->
        <Rectangle Fill="#80000000" Panel.ZIndex="1"/>

        <!-- 🌐 Chat UI Content -->
        <Grid Margin="20" Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Navbar -->
            <DockPanel Background="DarkOrange" Height="50" VerticalAlignment="Top" Grid.Row="0">
                <TextBlock Text="Chat Hub" 
                           Foreground="White" 
                           FontSize="20" 
                           VerticalAlignment="Center" 
                           Margin="20,0,0,0" />
            </DockPanel>

            <!-- Chat Messages -->
            <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatList" />
            </ScrollViewer>

            <!-- Input Area -->
            <DockPanel Grid.Row="2" Margin="0">
                <TextBox x:Name="UserInputBox"
                         FontSize="14"
                         Padding="10"
                         Height="40"
                         Background="#2D2D30"
                         Foreground="White"
                         BorderBrush="#800080"
                         BorderThickness="1"
                         Width="600"
                         DockPanel.Dock="Left"
                         Margin="0,0,10,0" />

                <Button Content="Send"
                        Width="100"
                        Height="40"
                        Background="DarkOrange"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="SendButton_Click" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
