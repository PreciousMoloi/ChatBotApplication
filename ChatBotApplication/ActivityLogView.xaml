<UserControl x:Class="ChatBotApplication.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="NavbarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ffa700" Offset="0"/>
            <GradientStop Color="#800080" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <!-- 🖼️ Background Image -->
        <Image Source="/images/flat-mountains (4).png"
               Stretch="UniformToFill"
               Panel.ZIndex="0"
               Opacity="0.8" />

        <!-- Blur Overlay -->
        <Rectangle Panel.ZIndex="1" Fill="#33000000">
            <Rectangle.Effect>
                <BlurEffect Radius="4" />
            </Rectangle.Effect>
        </Rectangle>

        <!-- Main Content -->
        <Grid Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Bar -->
            <DockPanel Grid.Row="0" Height="60" Background="{StaticResource NavbarGradient}" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" DockPanel.Dock="Left">
                    <TextBlock Text="CyberBot" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </DockPanel>

            <!-- Main Content with Rounded Container -->
            <Border Grid.Row="1" Margin="20" Background="#33FFFFFF" Padding="20" CornerRadius="10">
                <StackPanel>
                    <!-- Filter and Clear -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20" Background="Transparent">
                        <TextBlock Text="Filter by Category:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,10,0"/>
                        <ComboBox Width="150" SelectionChanged="FilterLog_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Task"/>
                            <ComboBoxItem Content="Quiz"/>
                            <ComboBoxItem Content="Chat"/>
                        </ComboBox>
                        <Button Content="Clear Log"
                                Margin="20,0,0,0"
                                Width="100"
                                Click="ClearLog_Click"
                                Background="#E74C3C"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderBrush="#C0392B"/>
                    </StackPanel>

                    <!-- Rounded DataGrid -->
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="#DADADA" Background="White" SnapsToDevicePixels="True">
                        <DataGrid ItemsSource="{Binding ActivityLog}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F2F2F2"
                                  FontSize="14"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontFamily="Segoe UI">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Width="200" Binding="{Binding Timestamp, StringFormat='{}{0:G}'}"/>
                                <DataGridTextColumn Header="Activity" Width="*" Binding="{Binding Description}"/>
                                <DataGridTextColumn Header="Category" Width="150" Binding="{Binding Category}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
