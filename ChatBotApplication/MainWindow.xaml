<Window x:Class="ChatBotApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatBotApplication"
        Title="Chat-Bot Prime" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <!-- Window Resources -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6a0080"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="NavbarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ab0202" Offset="0"/>
            <GradientStop Color="#395a6a" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <!-- Window Chrome -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <!-- Main Container -->
    <Border CornerRadius="15" Margin="10" Background="#1E1E1E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Color="Black" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <!-- Background Image -->
            <Image Source="/images/flat-mountains (4).png" 
                   Stretch="UniformToFill" 
                   Opacity="0.8"
                   Panel.ZIndex="0"/>

            <!-- Dark overlay -->
            <Rectangle Fill="#40000000" Panel.ZIndex="1"/>

            <!-- Main Grid with content and right nav -->
            <Grid Panel.ZIndex="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Main Content Area with Welcome Text and Frame -->
                <Grid Grid.Column="0" Margin="20">
                    <!-- Welcome Message -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
                        <TextBlock Text="Hello There, Nice To Meet You" 
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Let's Begin Your Journey to AI Bot" 
                                   FontSize="20"
                                   Foreground="White"
                                   TextAlignment="Center"/>
                    </StackPanel>

                   <!-- Dynamic Frame -->
                    <Frame x:Name="MainFrame"
                           NavigationUIVisibility="Hidden"
                           Background="Transparent"
                           Panel.ZIndex="2"/>
                </Grid>

                <!-- Navigation Bar on Right -->
                <Border Grid.Column="1" Background="{StaticResource NavbarGradient}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- App Name -->
                        <TextBlock Grid.Row="0"
                                   Text="Chat-Bot Prime" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,10,0,30" 
                                   HorizontalAlignment="Center"/>

                        <!-- Navigation Buttons -->
                        <UniformGrid Grid.Row="1" Rows="4" Margin="0,10">
                            <Button Content="TASK ASSISTANT"
                                    Background="Red"
                                    BorderThickness="2"
                                    BorderBrush="Black"
                                    Margin="0,0,0,10"
                                    Tag="TaskView"
                                    Click="NavButton_Click"/>

                            <Button Content="QUIZ MINI-GAME"
                                    Background="Red"
                                    BorderThickness="2"
                                    BorderBrush="Black"
                                    Margin="0,0,0,10"
                                    Tag="QuizView"
                                    Click="NavButton_Click"/>

                            <Button Content="CHAT ASSISTANT"
                                    Background="Red"
                                    BorderThickness="2"
                                    BorderBrush="Black"
                                    Margin="0,0,0,10"
                                    Tag="ChatView"
                                    Click="NavButton_Click"/>

                            <Button Content="ACTIVITY LOG"
                                    Background="Red"
                                    BorderThickness="2"
                                    BorderBrush="Black"
                                    Margin="0,0,0,0"
                                    Tag="ActivityLogView"
                                    Click="NavButton_Click"/>
                        </UniformGrid>

                        <!-- Window Controls -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                            <Button Content="─" Width="40" Background="Transparent" Click="MinimizeButton_Click"/>
                            <Button Content="✕" Width="40" Background="Transparent" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
