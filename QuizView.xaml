<UserControl x:Class="ChatBotApplication.Views.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="NavbarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ff032b" Offset="0"/>
            <GradientStop Color="#ffda03" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border CornerRadius="20"
            BorderThickness="3"
            BorderBrush="White"
            Margin="15"
            Background="#1A1A1A"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- Background Video -->
            <MediaElement x:Name="BackgroundVideo"
                          Source="images/abstract.mp4"
                          LoadedBehavior="Play"
                          UnloadedBehavior="Stop"
                          IsMuted="True"
                          Stretch="UniformToFill"
                          MediaEnded="BackgroundVideo_MediaEnded"
                          Panel.ZIndex="0"/>

            <!-- Content Layout Grid -->
            <Grid Panel.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Navbar -->
                    <RowDefinition Height="*"/>
                    <!-- Content -->
                </Grid.RowDefinitions>

                <!-- ✅ Navigation Bar -->
                <DockPanel Grid.Row="0" Height="60" Background="{StaticResource NavbarGradient}" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" DockPanel.Dock="Left">
                        <TextBlock Text="Secure Application" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </DockPanel>

                <!-- Quiz Main Content -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Text="Cyber Chat Quiz Test Your Knowledge" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0 0 0 20"/>

                    <!-- Quiz Content -->
                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10">
                        <TextBlock x:Name="QuestionText" 
                                   Text="Question will appear here" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   TextWrapping="Wrap" 
                                   Margin="0 0 0 20"/>

                        <StackPanel x:Name="OptionsPanel" Margin="0 0 0 20"/>

                        <Button x:Name="SubmitAnswerButton"
                                Content="Submit Answer" 
                                Background="Black" 
                                Foreground="White" 
                                FontSize="16" 
                                Padding="10" 
                                Width="150"
                                HorizontalAlignment="Left"
                                BorderBrush="White"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="SubmitAnswer_Click">
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="5" Color="Black" Opacity="0.3"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>

                    <!-- Score and Feedback -->
                    <StackPanel Grid.Row="2" Orientation="Vertical">
                        <TextBlock x:Name="ScoreText" 
                                   Text="Points: 0" 
                                   FontSize="16" 
                                   Foreground="White" 
                                   HorizontalAlignment="Right" 
                                   Margin="0,5,0,0"/>

                        <TextBlock x:Name="FeedbackText" 
                                   Text="" 
                                   FontSize="16" 
                                   Foreground="LightGreen" 
                                   HorizontalAlignment="Right" 
                                   Margin="0,5,0,0"/>

                        <ProgressBar x:Name="ScoreProgressBar" 
                                     Height="10" 
                                     Minimum="0" 
                                     Maximum="8" 
                                     Value="0"
                                     Foreground="#800080" 
                                     Background="#ffda03" 
                                     Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
